local isBurrowed = false
local originalY = 0

local function RestorePlayer(char, root, hum)
    isBurrowed = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = (p.Name == "HumanoidRootPart" or p.Name:find("Torso") or p.Name == "Head") end
    end
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {char}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local rayResult = Workspace:Raycast(Vector3.new(root.Position.X, originalY + 20, root.Position.Z), Vector3.new(0, -150, 0), rayParams)
    root.Velocity = Vector3.zero
    root.CFrame = CFrame.new(root.Position.X, (rayResult and (rayResult.Position.Y + 3) or originalY), root.Position.Z) * root.CFrame.Rotation
    hum:ChangeState(Enum.HumanoidStateType.Running)
end

