        if isSeated and c().AutoLockVehicle and seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
            local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
            local carModel = seat:FindFirstAncestorOfClass("Model")
            if vehiclesFolder then
                local current = seat
                while current and current.Parent ~= vehiclesFolder and current ~= Workspace do current = current.Parent end
                if current and current.Parent == vehiclesFolder then carModel = current end
            end
            if carModel then
                task.wait(0.1) 
                pcall(function() Network.send("lock_vehicle", carModel, true) end)
            end
        end
    end))
end

