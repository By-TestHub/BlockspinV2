local function IsInVehicle(hum)
    if not hum or not hum.SeatPart then return false end
    local seat = hum.SeatPart
    if seat:IsA("VehicleSeat") then return true end
    local vehiclesFolder = Workspace:FindFirstChild("Vehicles")
    if vehiclesFolder and seat:IsDescendantOf(vehiclesFolder) then return true end
    local model = seat:FindFirstAncestorOfClass("Model")
    if model and (model:FindFirstChildOfClass("VehicleSeat") or model:FindFirstChild("DriveSeat") or model:GetAttribute("IsVehicle")) then return true end
    return false
end

