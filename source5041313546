local function GetPredictedPosition(shootOrigin, targetPart, projectileSpeed, latency)
    if not targetPart or not targetPart:IsA("BasePart") then
        return shootOrigin
    end

    local targetPos = targetPart.Position
    local targetVel = targetPart.AssemblyLinearVelocity or targetPart.Velocity or Vector3.zero
    local distance = (targetPos - shootOrigin).Magnitude

    local speed = (projectileSpeed and projectileSpeed > 0) and projectileSpeed or 1000
    local pingDelay = latency or 0.03

    local timeToHit = (distance / speed) + pingDelay

    return targetPos + (targetVel * timeToHit)
end

if Network and typeof(Network.send) == "function" and not getgenv().OldNetworkSend then
    getgenv().OldNetworkSend = hookfunction(Network.send, function(...)
        local args = {...}

        if args[1] == "shoot_gun" and c().AimAssist and CurrentTarget then
            local targetPart = GetTargetPart(CurrentTarget)
            local char = Client.Character
            local cam = Workspace.CurrentCamera

            if targetPart and char and cam then
                local shootOrigin = cam.CFrame.Position
                local bulletSpeed = tonumber(c().ProjectileSpeed) or 1000
                local systemLatency = 0.03

                local predictPos = GetPredictedPosition(shootOrigin, targetPart, bulletSpeed, systemLatency)

                args[3] = CFrame.new(shootOrigin, predictPos)
                if type(args[4]) == "table" then
                    for _, v in pairs(args[4]) do
                        if type(v) == "table" then
                            for _, x in pairs(v) do
                                x.Normal = Vector3.new(0, 1, 0)
                                x.Position = predictPos
                                x.Instance = targetPart
                            end
                        end
                    end
                end
            end
        end

        return getgenv().OldNetworkSend(table.unpack(args))
    end)
end
