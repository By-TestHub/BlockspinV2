local function GetDeltaY(basePositionY, currentPositionY, offset)
    return (basePositionY - offset) - currentPositionY
end

local function RunSnap()
    local BasePosition = Char.get_hrp().Position
    local OffsetY = c().SnapAmount or 10

    while task.wait() do 
        if c().Snap then  
            xpcall(function()
                if Character and Character:FindFirstChild("Humanoid") and Character.Humanoid.Health > 0 then
                    local CurrentOffset = c().SnapAmount or 10
                    if CurrentOffset ~= OffsetY then
                        OffsetY = CurrentOffset
                    end

                    local CurrentY = Char.get_hrp().Position.Y
                    local deltaY = GetDeltaY(BasePosition.Y, CurrentY, CurrentOffset)			
                    Char.get():PivotTo(Char.get_hrp().CFrame * CFrame.new(0, deltaY, 0))
                end
            end, warn)
        else
            break
        end
    end
end

